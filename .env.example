PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/edx_ai_resume_analyzer
JWT_SECRET=replace_with_a_strong_secret
CLIENT_URL=http://localhost:5173

# How resumes are analysed:
#   local  = our own built-in engine. No key, no internet needed. (default)
#   hybrid = built-in engine + extra advice from Google Gemini (needs the key below)
ANALYSIS_ENGINE=local
GEMINI_API_KEY=
